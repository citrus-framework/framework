{
  "name": "citrus-framework/framework",
  "description": "php web framework",
  "keywords": ["citrus", "php", "framework"],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/citrus-framework/framework",
  "authors": [
    {
      "name": "take64",
      "email": "take64@citrus.tk"
    }
  ],
  "require": {
    "citrus-framework/configure": "^v1.0",
    "citrus-framework/console": "^v1.0",
    "citrus-framework/contract": "^v1.0",
    "citrus-framework/http": "^v1.0",
    "citrus-framework/logger": "^v1.0",
    "citrus-framework/query": "^v1.0",
    "citrus-framework/variables": "^v1.1",
    "php": "^8.3"
  },
  "suggest": {
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-memcached": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-posix": "*",
    "ext-redis": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^v10",
    "nunomaduro/phpinsights": "^v2"
  },
  "autoload": {
    "psr-4": {
      "Citrus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
